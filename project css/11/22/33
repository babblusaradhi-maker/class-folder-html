<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff Login | Wildlife Rescue Management</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: #edf2ee;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    .login-card {
      background-color: #ffffff;
      width: 100%;
      max-width: 420px;
      padding: 36px 32px;
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(27, 67, 50, 0.08);
      border-top: 6px solid #2d6a4f;
    }

    .brand-header {
      text-align: center;
      margin-bottom: 28px;
    }

    .brand-icon {
      font-size: 36px;
      margin-bottom: 8px;
    }

    .brand-header h1 {
      color: #1b4332;
      font-size: 22px;
      font-weight: 700;
    }

    .brand-header p {
      color: #52796f;
      font-size: 14px;
      margin-top: 4px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #1b4332;
      margin-bottom: 6px;
    }

    input[type="email"],
    input[type="password"],
    select {
      width: 100%;
      padding: 11px 14px;
      border: 1px solid #cad2c5;
      border-radius: 6px;
      font-size: 14px;
      color: #2f3e46;
      background-color: #fafafa;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    input:focus,
    select:focus {
      outline: none;
      border-color: #2d6a4f;
      background-color: #ffffff;
      box-shadow: 0 0 0 3px rgba(45, 106, 79, 0.15);
    }

    .form-options {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      margin-bottom: 22px;
      color: #52796f;
    }

    .remember-me {
      display: flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }

    .forgot-link {
      color: #2d6a4f;
      text-decoration: none;
      font-weight: 600;
    }

    .forgot-link:hover {
      text-decoration: underline;
    }

    .btn-submit {
      width: 100%;
      padding: 12px;
      background-color: #2d6a4f;
      color: #ffffff;
      border: none;
      border-radius: 6px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s;
    }

    .btn-submit:hover {
      background-color: #1b4332;
    }

    .footer-note {
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px solid #e9ecef;
      text-align: center;
      font-size: 12px;
      color: #6c757d;
    }

    .emergency-badge {
      display: inline-block;
      margin-top: 6px;
      color: #b02a37;
      font-weight: 600;
    }
  </style>
</head>
<body>

  <main class="login-card">
    <div class="brand-header">
      <div class="brand-icon" aria-hidden="true">🦉</div>
      <h1>Wildlife Rescue Portal</h1>
      <p>Rescue • Rehabilitate • Release</p>
    </div>

    <!-- Replace "/login" with your actual backend authentication endpoint -->
    <form action="/login" method="POST">
      <div class="form-group">
        <label for="role">Access Role</label>
        <select id="role" name="role" required>
          <option value="rescuer">Field Rescuer / Volunteer</option>
          <option value="vet">Veterinarian / Rehab Specialist</option>
          <option value="admin">Center Administrator</option>
        </select>
      </div>

      <div class="form-group">
        <label for="email">Staff Email</label>
        <input type="email" id="email" name="email" placeholder="name@wildliferescue.org" required autocomplete="email">
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Enter your password" required autocomplete="current-password">
      </div>

      <div class="form-options">
        <label class="remember-me">
          <input type="checkbox" name="remember"> Keep me signed in
        </label>
        <a href="#reset-password" class="forgot-link">Forgot password?</a>
      </div>

      <button type="submit" class="btn-submit">Sign In to Dashboard</button>
    </form>

    <div class="footer-note">
      <p>Authorized rescue personnel only.</p>
      <span class="emergency-badge">24/7 Dispatch Hotline: (555) 019-2834</span>
    </div>
  </main>

</body>
</html>
